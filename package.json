{
  "name": "poe2-build-nexus",
  "private": true,
  "version": "2.0.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/assemble.mjs",
    "test": "vitest run && node --test scripts/economy.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write v2/src scripts e2e *.ts *.json",
    "format:check": "prettier --check v2/src scripts e2e *.ts *.json",
    "check": "npm run test && npm run build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.2"
  }
}
